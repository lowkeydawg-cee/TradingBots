# Copy to .env and fill in. Paper keys only: https://app.alpaca.markets/paper/dashboard/overview
BOT_MODE=alpaca            # alpaca | sim
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_DATA_FEED=iex       # iex (free) | sip (paid plan)

PAIR_SYMBOL_A=KO
PAIR_SYMBOL_B=PEP
TIMEFRAME_MINUTES=1
HEDGE_LOOKBACK=390
Z_LOOKBACK=60
POLL_SECONDS=60

ENTRY_Z=2.0
EXIT_Z=0.5
STOP_Z=3.5
MAX_HOLDING_BARS=390
MIN_COINT_PVALUE=0.05

LEG_NOTIONAL=2000
MAX_GROSS_EXPOSURE=10000
MAX_DAILY_LOSS_USD=300
MAX_DAILY_LOSS_PCT=0.02
MAX_CONSECUTIVE_ERRORS=5

PAIRS_DB_PATH=pairs_bot.db

# --- Portfolio (upgrade 4). Overrides PAIR_SYMBOL_A/B. No stock in two pairs.
#     Run `python scanner.py --source alpaca ...` to find candidates.
# PAIRS=KO:PEP,XOM:CVX,V:MA
RISK_PER_TRADE_USD=0        # >0: size each trade so a stop-out loses about this much
MAX_WEEKLY_LOSS_PCT=0.04    # halt if down 4% since Monday's open
MAX_MONTHLY_LOSS_PCT=0.08   # halt if down 8% since the 1st of the month
RETIRE_PVALUE=0.10          # a pair whose cointegration p-value stays above this...
RETIRE_DAYS=5               # ...for this many trading days stops opening trades

# --- Model (upgrade 3)
HEDGE_METHOD=ols            # ols | kalman (adaptive hedge ratio)
KALMAN_DELTA=0.001          # how fast the Kalman hedge ratio may drift
MAX_VOL_RATIO=3.0           # no entries while recent spread moves are 3x normal
BLACKOUT_FILE=blackout.csv  # earnings dates to stay out (copy blackout.csv.example)
NEWS_PAUSE_MINUTES=30       # no entries within 30 min of a headline (0 = off)

# --- Execution (upgrade 2)
ORDER_TYPE=limit            # limit (patient, cheaper) | market
LIMIT_TIMEOUT_SECONDS=20    # how long the first leg waits at the mid price
MAX_SLIPPAGE_BPS=10         # most the second leg may pay above the quote
MAX_QUOTE_SPREAD_BPS=15     # skip entries when the bid/ask spread is wider

# --- Service (upgrade 5)
DATA_SOURCE=poll            # poll | stream (websocket bars)
TELEGRAM_BOT_TOKEN=         # see notify.py for the 5-minute setup
TELEGRAM_CHAT_ID=
NOTIFY_TRADES=1             # 0 = only halts and the daily report
DASHBOARD_PASSWORD=         # set this when the dashboard is reachable from your phone
